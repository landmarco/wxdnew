DB_HOST=localhost
DB_USER=wxdu_pl
DB_PASSWORD=
DB_NAME=plmanager

# Website feedback DB (see api/feedback_table.sql for setup)
FEEDBACK_DB_HOST=localhost
FEEDBACK_DB_USER=wxdu_feedback
FEEDBACK_DB_PASSWORD=
FEEDBACK_DB_NAME=feedback

# Shazam stream-recognition (see api/shazam_table.sql for setup).
# Reader/writer for plmanager.shazamplaying; fed by the stream-sleuth tool on
# the iMac, read back by /api/shazam and /api/shazam/latest.
SHAZAM_DB_HOST=localhost
SHAZAM_DB_USER=wxdu_shazam
SHAZAM_DB_PASSWORD=
SHAZAM_DB_NAME=plmanager
# Shared secret the iMac recognizer must send as X-Ingest-Secret
SHAZAM_INGEST_SECRET=

# Twitch livestream status for the homepage takeover widget (/api/twitch/status).
# Register an app at https://dev.twitch.tv/console/apps (OAuth redirect URL can
# be http://localhost — we only use the client-credentials flow, never a user
# login) and paste its client id/secret here. Leave blank and the endpoint just
# reports "not live", so the widget stays hidden.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Channel to watch, without the twitch.tv/ prefix.
TWITCH_CHANNEL=wxdu887

# Port this API listens on (nginx proxies 443 → this)
PORT=3001

# Comma-separated list of allowed CORS origins. Matched EXACTLY — scheme, host
# and port all count, and https://www.wxdu.org is a different origin from
# https://wxdu.org. A missing entry surfaces as a 500, not a clean CORS error
# (server.js hands an Error to the cors callback), so an origin you forgot
# looks like the API is down. Read once at startup: `pm2 restart wxdu-api`
# after changing this, not a reload.
#
# During the wxdu.org migration, also add the Cloudflare Pages preview origin
# you are testing from (e.g. https://wxdu-website.pages.dev) and remove it once
# the domain cutover is done.
ALLOWED_ORIGINS=https://wxdu.art,https://wxdu.org,https://www.wxdu.org,http://localhost:3000
