# nginx reverse proxy for the wxdu-api Node service (127.0.0.1:3001).
# nginx terminates TLS and proxies straight to Node — there is no Apache in
# this path. (The old Apache setup is kept for reference in apache.conf.example.)
#
# WHERE THIS LIVES ON THE SERVER: beachyhead names nginx site files after the
# IP they bind to, not the hostname, so the live copy of this config is
# /etc/nginx/sites-available/152.229 (the 152.3.0.229 front door) — not
# `api.wxdu.art`. Locate it rather than assuming:
#     grep -rln "api.wxdu.art" /etc/nginx/sites-available/
#
# THIS FILE IS ONLY PART OF 152.229. That file also carries the
# beachyhead.wxdu.duke.edu default_server blocks (:80 and :443) that proxy to
# Apache on :8080 — 6 GB album uploads, relaxed body timeouts, and the plain-
# http /api/confirm, /api/special_confirm and /api/upload carve-outs the old
# itunes-crawler depends on. Never `cp` this example over 152.229; you would
# delete all of that. Edit the api.wxdu.* blocks in place instead.
#
# Setup steps (on a genuinely fresh host):
#   1. Copy this file in, using whatever name matches local convention:
#        sudo cp nginx.conf.example /etc/nginx/sites-available/152.229
#   2. Enable it:
#        sudo ln -s /etc/nginx/sites-available/152.229 /etc/nginx/sites-enabled/
#   3. Test and reload:
#        sudo nginx -t && sudo systemctl reload nginx
#   4. Get / install a Let's Encrypt cert covering BOTH API hostnames (certbot
#      edits this file and sets up auto-renewal via the nginx authenticator):
#        sudo certbot --nginx -d api.wxdu.art -d api.wxdu.org
#
# --- api.wxdu.org ---
# Both names are on server_name below. api.wxdu.org already resolves to
# 152.3.0.229, so nothing here is waiting on Duke OIT. Two failure modes to
# know about:
#   - Drop api.wxdu.org from server_name and requests for it fall through to
#     the catch-all block, which proxies to Apache and returns a 404.
#   - Until the cert is expanded, TLS to api.wxdu.org fails outright — the
#     api.wxdu.art cert has a single SAN and does not cover it. Browsers hard-
#     fail before CORS is ever reached. Use the certbot line above and take the
#     "expand" option so renewal stays one lineage.
#
# The frontend needs NO rebuild for the switch: lib/api.js derives the API host
# from window.location.hostname at runtime (wxdu.org -> api.wxdu.org). Do NOT
# set NEXT_PUBLIC_API_URL in Cloudflare Pages to chase this — it only affects
# hostnames that aren't wxdu.art/.org, i.e. *.pages.dev previews, which should
# keep pointing at api.wxdu.art.
#
# ALLOWED_ORIGINS in .env DOES need every origin you actually serve. Note that
# https://www.wxdu.org is a different origin from https://wxdu.org; a missing
# entry surfaces as a 500, not a clean CORS rejection (see server.js).

server {
    listen 152.3.0.229:80;
    server_name api.wxdu.art api.wxdu.org;
    # $host, not a literal — .org requests redirect to themselves, not to .art.
    return 301 https://$host$request_uri;
}

server {
    listen 152.3.0.229:443 ssl;
    server_name api.wxdu.art api.wxdu.org;

    # certbot --nginx manages these two lines. The cert must cover both names
    # above — see the api.wxdu.org note in the header.
    ssl_certificate     /etc/letsencrypt/live/api.wxdu.art/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.wxdu.art/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Server-Sent Events stream (live now-playing / current playlist). It must
    # NOT be buffered and must survive a long, mostly-idle connection:
    #   proxy_buffering off  — flush each event to the browser immediately
    #   proxy_read_timeout   — don't drop the connection between events/heartbeats
    # (The Node route also sends `X-Accel-Buffering: no`, which nginx honours.)
    location /api/playlists/current/stream {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # --- Optional: response caching ---
        # Several routes send `Cache-Control: s-maxage=...`, which does nothing
        # unless a shared cache sits in front of Node. Uncommenting the block
        # below makes nginx that cache, so repeat requests never reach Node or
        # MySQL. Prerequisite — add the zone to the `http { }` block in
        # /etc/nginx/nginx.conf (it CANNOT live in server/location context):
        #
        #   proxy_cache_path /var/cache/nginx/wxdu-api levels=1:2
        #                    keys_zone=wxdu_api:10m max_size=512m
        #                    inactive=10m use_temp_path=off;
        #
        # Keep these directives HERE rather than at server level: the SSE
        # location above must never be cached, and sibling locations don't
        # inherit from this one.
        #
        # proxy_cache wxdu_api;
        # # Fallback TTL for responses with no Cache-Control of their own.
        # # nginx prefers the upstream header when present, so routes that set
        # # s-maxage keep control of their own freshness.
        # proxy_cache_valid 200 15s;
        # # One request repopulates a cold/expired entry; the rest wait for it
        # # instead of stampeding Node.
        # proxy_cache_lock on;
        # # Serve the stale copy while that refresh happens in the background —
        # # nginx's equivalent of the `stale-while-revalidate` the routes send.
        # proxy_cache_use_stale updating error timeout;
        # proxy_cache_background_update on;
        # # HIT / MISS / EXPIRED / UPDATING — check with `curl -I`.
        # add_header X-Cache-Status $upstream_cache_status always;
    }
}

# NOTE ON CACHING: nginx only caches GET and HEAD by default, so the
# `POST /api/shazam` ingest endpoint is never served from cache. The cache key
# includes the query string, so `?limit=5` and `?limit=all` are separate
# entries. nginx also honours `Vary: Origin` (which the CORS middleware sets),
# so each allowed origin gets its own entry rather than one origin's
# Access-Control-Allow-Origin header being served to another.

# NOTE: express-rate-limit in the API keys on the real client IP, which comes
# from the X-Forwarded-For header set above plus `app.set('trust proxy', 1)` in
# server.js — exactly one proxy hop (nginx -> Node). Keep those in sync.
